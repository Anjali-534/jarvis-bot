# Copy this file to .env and fill in what you need. Everything has a default.

# --- Identity ---
ASSISTANT_NAME=Jarvis
USER_NAME=Anjali

# --- Wake word ---
WAKE_WORD_ENABLED=true
WAKE_WORDS=jarvis,hey jarvis,ok jarvis
# After Jarvis replies, you can talk without the wake word for this many seconds
FOLLOW_UP_SECONDS=20

# --- Voice ---
SPEECH_LANGUAGE=en-IN
# Part of a Windows voice name, e.g. zira, david, heera, ravi
VOICE_NAME=zira
VOICE_RATE=170

# --- Location / air quality ---
DEFAULT_LOCATION=New Delhi
COUNTRY_CODE=in
# Optional: free token from https://aqicn.org/data-platform/token/ for real CPCB station red zones
WAQI_TOKEN=
RED_ZONE_THRESHOLD=200

# --- AI fallback (any OpenAI-compatible API) ---
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Files ---
NOTES_FILE=data/notes.txt
SCREENSHOT_DIR=~/Pictures/Jarvis Screenshots

# --- WhatsApp ---
# Contacts: copy contacts.example.json to data/contacts.json, or say "add contact riya 9876543210"
CONTACTS_FILE=data/contacts.json
# Seconds to wait for WhatsApp Desktop to open the chat before pressing Enter (raise it on a slow laptop)
WHATSAPP_SEND_DELAY=3

# --- VS Code projects ---
# Folders scanned (2 levels deep) for projects; separate several with ;
PROJECT_ROOTS=C:\Users\ADMIN\OneDrive\Desktop\ANJALI
# Optional manual aliases, see projects.example.json
PROJECTS_FILE=data/projects.json

# --- Background mode ---
# Global hotkey that wakes Jarvis without the wake word (leave empty to disable)
HOTKEY=ctrl+alt+j
# Show Windows toasts for reminders and timers
NOTIFY=true
LOG_DIR=data/logs
