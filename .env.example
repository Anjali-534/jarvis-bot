# Copy this file to .env and fill in what you need. Everything has a default.

# --- Identity ---
ASSISTANT_NAME=Jarvis
USER_NAME=Anjali

# --- Wake word ---
# The offline "Hey Jarvis" detector (openWakeWord) runs locally; nothing is sent anywhere until it hears you.
WAKE_WORD_ENABLED=true
# 0-1: lower wakes more easily (and falsely), higher needs a clearer "Hey Jarvis"
WAKE_SENSITIVITY=0.5
# Used only if openWakeWord can't load: wake phrases looked for in the transcript
WAKE_WORDS=jarvis,hey jarvis,ok jarvis
# After Jarvis replies, you can talk without the wake word for this many seconds
FOLLOW_UP_SECONDS=20

# --- Voice ---
SPEECH_LANGUAGE=en-IN
# Part of a Windows voice name, e.g. zira, david, heera, ravi
VOICE_NAME=zira
VOICE_RATE=185

# --- Location / air quality ---
DEFAULT_LOCATION=New Delhi
COUNTRY_CODE=in
# Optional: free token from https://aqicn.org/data-platform/token/ for real CPCB station red zones
WAQI_TOKEN=
RED_ZONE_THRESHOLD=200

# --- AI ---
# AI_PROVIDER: openai (any OpenAI-compatible API, e.g. Groq or OpenAI) or gemini (Google's native Gemini API;
# AQ. and AIza keys both work). Empty = gemini if AI_BASE_URL is a generativelanguage URL.
# Recommended: Groq (free key at console.groq.com/keys), the fastest for voice.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b
# Seconds to wait for an AI reply
AI_TIMEOUT=15
# Reasoning models only (Groq's qwen/... or openai/gpt-oss-...): none or low makes answers much faster.
AI_REASONING_EFFORT=none
# Optional backup AI (Gemini, free key at aistudio.google.com/apikey). If the main AI hits a rate limit, is down,
# times out or rejects its key/model, the same request is retried once on Gemini ("Switching to my backup brain").
# After Groq's DAILY limit, Gemini is used until midnight IST. Empty = no backup.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds to wait for Gemini to pick an action (it's slower than Groq)
GEMINI_ROUTER_TIMEOUT=8
# If AI_MODEL is retired, Jarvis switches to the first of these the provider still offers (then any chat
# model), retries, and rewrites only the AI_MODEL line above. It also checks AI_MODEL once a day at startup.
AI_MODEL_FALLBACKS=qwen/qwen3.8-27b,openai/gpt-oss-20b,openai/gpt-oss-120b
# Natural-language actions ("yaar thoda sound badha do" -> volume up). Used only when no command pattern matches.
AI_ROUTING=true
# A small, fast model for picking the action (empty = AI_MODEL), and how long to wait for it
AI_ROUTER_MODEL=
AI_ROUTER_TIMEOUT=4

# --- Web search (answered by voice) ---
# auto = Tavily (if TAVILY_API_KEY is set), then Groq's web-search model (if your key has it), then free
# DuckDuckGo/Yahoo results via ddgs with the top 3 pages read. Or list them, e.g. SEARCH_PROVIDER=ddgs
SEARCH_PROVIDER=auto
# Optional, free tier: https://app.tavily.com
TAVILY_API_KEY=
# Seconds for searching + reading pages, and how long results are reused
SEARCH_BUDGET=8
SEARCH_CACHE_MINUTES=30

# --- Files ---
NOTES_FILE=data/notes.txt
SCREENSHOT_DIR=~/Pictures/Jarvis Screenshots

# --- WhatsApp ---
# Contacts: copy contacts.example.json to data/contacts.json, or say "add contact riya 9876543210"
CONTACTS_FILE=data/contacts.json
# Seconds to wait for WhatsApp Desktop to open the chat before pressing Enter (raise it on a slow laptop)
WHATSAPP_SEND_DELAY=3

# --- VS Code projects ---
# Folders scanned (2 levels deep) for projects; separate several with ;
PROJECT_ROOTS=C:\Users\ADMIN\OneDrive\Desktop\ANJALI
# Optional manual aliases, see projects.example.json
PROJECTS_FILE=data/projects.json

# --- Background mode ---
# Global hotkey that wakes Jarvis without the wake word (leave empty to disable)
HOTKEY=ctrl+alt+j
# Show Windows toasts for reminders and timers
NOTIFY=true
LOG_DIR=data/logs

# --- Google: Gmail + Calendar (say "connect google"; setup steps are in the README) ---
# OAuth client JSON downloaded from Google Cloud Console, and where the sign-in token is saved (both git-ignored)
GOOGLE_CREDENTIALS_FILE=data/google_credentials.json
GOOGLE_TOKEN_FILE=data/google_token.json
# Spoken reminder + toast this many minutes before each calendar event (only while Google is connected)
CALENDAR_REMINDERS=true
CALENDAR_REMINDER_MINUTES=10

# --- Spotify (say "connect spotify"; setup steps are in the README) ---
# Client ID of your app at https://developer.spotify.com/dashboard (no client secret needed)
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_TOKEN_FILE=data/spotify_token.json

# --- Daily briefing ("good morning Jarvis") ---
# Sections, in order: weather, aqi, calendar, email, reminders, news
BRIEFING_SECTIONS=weather,aqi,calendar,email,reminders,news
# HH:MM: give the briefing automatically once a day, if Jarvis is running and you've been idle (empty = off)
BRIEFING_TIME=
# Optional: played on Spotify after the briefing, e.g. lofi beats
BRIEFING_MUSIC=

# --- Speed ---
# Speech-to-text: google (online) or whisper (faster-whisper, runs locally; CUDA if you have an NVIDIA GPU)
# Compare them on your machine: say "record samples", then run: python -m jarvis.benchmark
STT_ENGINE=google
# Seconds to wait for you to start talking, and the longest command
LISTEN_TIMEOUT=5
PHRASE_LIMIT=7
# Milliseconds of silence that end a command
END_SILENCE_MS=600
# Say "One sec" when a skill takes longer than this many seconds
ONE_SEC_AFTER=1.5
# Weather and AQI are cached on disk (data/cache.json) for this many minutes
CACHE_MINUTES=10
